FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV KOKKOS_ROOT=/opt/kokkos
ENV PATH="/opt/kokkos/bin:${PATH}"

# Install compilers, CMake, Ninja, Python and base build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    gfortran \
    cmake \
    ninja-build \
    git \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# The MKPP package requires Python >= 3.11 (pyproject.toml); ubuntu:22.04
# ships 3.10, which lacks enum.StrEnum used by mkpp.benchmark.models.
# Install 3.11 from the deadsnakes PPA and make it the default python3/pip3.
# This MUST precede the pip layer below so packages land in 3.11's site-packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    gnupg \
    gpg-agent \
    dirmngr \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3.11 /tmp/get-pip.py --root-user-action=ignore \
    && rm /tmp/get-pip.py \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python

# Ubuntu's apt setuptools (59.x, in /usr/lib/python3/dist-packages) is visible
# to deadsnakes 3.11 and pre-dates PEP 660, which breaks
# `pip install --no-build-isolation -e .` used by CI.  --ignore-installed
# forces a modern copy into /usr/local that shadows it on sys.path.
RUN pip3 install --no-cache-dir --root-user-action=ignore --ignore-installed \
    setuptools \
    wheel

# Install Python packages required for MKPP build and testing
# NOTE: jsonschema must be pre-baked here: CTest targets that shell out to
# pytest (e.g. solver_benchmark_contract_admission_smoke) import
# mkpp.benchmark.schema, and the "pip install -e ." CI step may target a
# different interpreter than the configure-time Python3 used by CTest.
RUN pip3 install --no-cache-dir --root-user-action=ignore \
    cmake \
    ninja \
    pyyaml \
    sympy \
    jinja2 \
    networkx \
    matplotlib \
    pytest \
    pytest-xdist \
    jsonschema \
    hypothesis \
    numpy \
    scipy \
    pre-commit \
    ruff \
    mkdocs-material \
    mkdocstrings \
    mkdocstrings-python

# Build and install the minimum supported Kokkos 5.1.1 to /opt/kokkos
RUN git clone --depth 1 --branch 5.1.1 https://github.com/kokkos/kokkos.git /tmp/kokkos-src && \
    cmake -S /tmp/kokkos-src -B /tmp/kokkos-build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/kokkos \
      -DKokkos_ENABLE_SERIAL=ON \
      -DKokkos_ENABLE_OPENMP=OFF \
      -DKokkos_ENABLE_CUDA=OFF && \
    cmake --build /tmp/kokkos-build -j $(nproc) && \
    cmake --install /tmp/kokkos-build && \
    rm -rf /tmp/kokkos-src /tmp/kokkos-build
