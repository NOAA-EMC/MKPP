{#
  Device-callable implementation fragment: Jacobian chunks.

  Mirrors the rate fragment for the sparse Jacobian. Emitting the chunk bodies
  as KOKKOS_INLINE_FUNCTION definitions (rather than host-only out-of-line
  symbols) is what lets a device instantiation of SolverKernels resolve the
  compute_jacobian call chain.

  Context: mechanism_name, num_species, compiled_jacobian_chunks, has_equilibrium, has_cloud_gated
#}
#pragma once
#include <Kokkos_Core.hpp>
namespace mkpp::generated::{{ mechanism_name }}::detail {
{% for expressions in compiled_jacobian_chunks %}
KOKKOS_INLINE_FUNCTION void compute_jacobian_chunk_{{ loop.index0 }}(
    const double* state, double* jacobian,
    const double* jvals, double temp, double rh{% if has_cloud_gated %}, double clw{% endif %}) {
{% if has_equilibrium %}
  const double Temp = temp;
  const double RH = rh;
  (void)RH;
{% if has_cloud_gated %}
  const double CLW = clw;
  (void)CLW;  // Referenced only by the gated reaction's chunk.
{% endif %}
{% else %}
  (void)temp;
  (void)rh;
{% endif %}
{% for expression in expressions %}
  jacobian[{{ expression.row }} * {{ num_species }} + {{ expression.column }}] = {{ expression.expr }};
{% endfor %}
}
{% endfor %}
}  // namespace mkpp::generated::{{ mechanism_name }}::detail
