{#
  Device-callable implementation fragment: portable supernodal LU plan.

  factorize_plan is called from the integrator's KOKKOS_INLINE_FUNCTION body,
  so it must be an inline definition for a device instantiation to resolve the
  full call chain. The symbolic L/U masks are the same plan the reference
  backend uses; chemistry algebra is not forked.

  Context: mechanism_name, num_species, plan_l_pattern, plan_u_pattern
#}
#pragma once
#include <Kokkos_Core.hpp>
namespace mkpp::generated::{{ mechanism_name }}::detail {
KOKKOS_INLINE_FUNCTION void factorize_plan(const double* w, double* lu) {
  constexpr int N = {{ num_species }};
  static constexpr unsigned char L[N * N] = {
    {{ plan_l_pattern | join(', ') }}
  };
  static constexpr unsigned char U[N * N] = {
    {{ plan_u_pattern | join(', ') }}
  };
  for (int row = 0; row < N; ++row)
    for (int column = 0; column < N; ++column)
      lu[row * N + column] = 0.0;
  for (int row = 0; row < N; ++row) {
    for (int column = row; column < N; ++column) {
      if (!U[row * N + column]) continue;
      double value = w[row * N + column];
      for (int inner = 0; inner < row; ++inner)
        if (L[row * N + inner] && U[inner * N + column])
          value -= lu[row * N + inner] * lu[inner * N + column];
      lu[row * N + column] = value;
    }
    for (int lower_row = row + 1; lower_row < N; ++lower_row) {
      if (!L[lower_row * N + row]) continue;
      double value = w[lower_row * N + row];
      for (int inner = 0; inner < row; ++inner)
        if (L[lower_row * N + inner] && U[inner * N + row])
          value -= lu[lower_row * N + inner] * lu[inner * N + row];
      lu[lower_row * N + row] = value / lu[row * N + row];
    }
  }
}
}  // namespace mkpp::generated::{{ mechanism_name }}::detail
