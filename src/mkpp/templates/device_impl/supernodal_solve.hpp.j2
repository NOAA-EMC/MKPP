{#
  Device-callable implementation fragment: portable forward/backward solve.

  solve_plan is invoked from the integrator's KOKKOS_INLINE_FUNCTION body, so
  it must be an inline definition for a device instantiation to resolve the
  whole chain. The bounded loops are the symbolic sparse plan, not chemistry
  algebra, so no dynamic allocation is introduced.

  Context: mechanism_name, num_species
#}
#pragma once
#include <Kokkos_Core.hpp>
namespace mkpp::generated::{{ mechanism_name }}::detail {
KOKKOS_INLINE_FUNCTION void solve_plan(const double* lu, const double* rhs, double* solution) {
  constexpr int N = {{ num_species }};
  double work[N];
  for (int row = 0; row < N; ++row) {
    work[row] = rhs[row];
    for (int column = 0; column < row; ++column) work[row] -= lu[row * N + column] * work[column];
  }
  for (int row = N - 1; row >= 0; --row) {
    solution[row] = work[row];
    for (int column = row + 1; column < N; ++column) solution[row] -= lu[row * N + column] * solution[column];
    solution[row] /= lu[row * N + row];
  }
}
}  // namespace mkpp::generated::{{ mechanism_name }}::detail
