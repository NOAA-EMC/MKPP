{#
  Kernel function template: compute_jacobian (Jacobian matrix evaluation).

  Renders the `compute_jacobian()` function which evaluates the analytical
  Jacobian matrix J[i,j] = dF_i/dC_j at the given state.

  Only non-zero entries are emitted (sparse Jacobian).

  Context variables required:
    - num_species: int
    - jacobian_entries_state: list of (i, j, expr) tuples using state(i) format
    - has_equilibrium: bool (if true, signature includes temp, rh params)

  Requirements: 4.6
#}
      /**
       * @brief Evaluates the sparse analytical Jacobian matrix J(i, j) = dF_i / dC_j.
       *
       * @tparam StateView Kokkos View type for species concentrations [NUM_SPECIES].
       * @tparam JacView Kokkos View type for output 2D Jacobian matrix [NUM_SPECIES x NUM_SPECIES].
       * @param state Input concentration vector [NUM_SPECIES].
       * @param J_block Output 2D Jacobian matrix [NUM_SPECIES x NUM_SPECIES].
       * @param jvals Array of photolysis rate constants [NUM_PHOTOLYSIS].
       */
      template <class StateView, class JacView>
{% if has_equilibrium %}
      KOKKOS_INLINE_FUNCTION void compute_jacobian(const StateView& state, JacView& J_block, const double* jvals, const double temp, const double rh{% if has_cloud_gated %}, const double clw{% endif %}) const {
{% for chunk in compiled_jacobian_chunks %}
          detail::compute_jacobian_chunk_{{ loop.index0 }}(state.data(), J_block.data(), jvals, temp, rh{% if has_cloud_gated %}, clw{% endif %});
{% endfor %}
{% else %}
      KOKKOS_INLINE_FUNCTION void compute_jacobian(const StateView& state, JacView& J_block, const double* jvals) const {
{% for chunk in compiled_jacobian_chunks %}
          detail::compute_jacobian_chunk_{{ loop.index0 }}(state.data(), J_block.data(), jvals, 0.0, 0.0);
{% endfor %}
{% endif %}
      }
